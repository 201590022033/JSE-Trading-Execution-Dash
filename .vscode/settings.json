{
  "python.terminal.useEnvFile": true,
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv",
  "python.testing.pytestEnabled": false,
  "python.testing.unittestEnabled": false,
  "workbench.browser.dataStorage": "agent",
  "workbench.browser.enableRemoteProxy": true,
  "workbench.browser.experimentalUserTools.enabled": true,
  "editor.defaultFormatter": "GitHub.copilot-chat",
  "editor.defaultFoldingRangeProvider": "GitHub.copilot-chat",
  "workbench.editor.defaultBinaryEditor": "chatgpt.conversationEditor",
  "notebook.defaultFormatter": "GitHub.codespaces",
  "workbench.browser.sendElementsToChat.attachImages": true
}
